---
import { context } from '~/i18n';
const { t, p } = context(Astro.url.pathname);
import Icon from './Icon.astro';
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  action?: string;
  href?: string;
}
const { eyebrow, title, description, action, href = p('/zh/contact/') } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label={t('面包屑')}>
      <a href={p('/zh/')}>{t('首页')}</a><span aria-hidden="true">/</span><span>{eyebrow}</span>
    </nav><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="intro">{description}</p>{
      action && (
        <div class="hero-actions">
          <a class="button primary" href={href}>
            {action}
            <Icon name="diagonal" size={18} />
          </a>
        </div>
      )
    }
  </div>
</section>
