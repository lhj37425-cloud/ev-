---
import { context } from '~/i18n';
const { t, p } = context(Astro.url.pathname);
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ScenarioImage from '../../components/ScenarioImage.astro';
import ContactSection from '../../components/ContactSection.astro';
import hero from '../../assets/images/workshop.png';
import { getData } from '~/data/site';
import { locales } from '~/i18n';
const { services, scenarios, steps, faqs } = getData(context(Astro.url.pathname).locale);
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-photo">
      <Image
        src={hero}
        alt={t('企业团队共同讨论AI应用的场景示意')}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 700px) 100vw, 72vw"
        format="webp"
        quality={88}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-wash"></div>
    <div class="container hero-content">
      <p class="eyebrow">{t('立足越南 · 服务企业')}</p><h1 id="hero-title">
        {t('用AI，为企业')}<br />{t('降本增收')}
      </h1><span class="red-rule"></span><p class="hero-subtitle">
        {t('从人才培养到Agent部署')}<br />{t('减少重复投入，支持业务增长')}
      </p><div class="hero-actions">
        <a class="button primary" href="#contact">{t('预约企业AI咨询')}<Icon name="diagonal" size={19} /></a><a
          class="button outline"
          href="#services">{t('了解我们的服务')}<Icon size={19} /></a
        >
      </div><p class="hero-tags">{t('AI培训')}<span>/</span>{t('Agent部署')}<span>/</span>{t('项目实施')}</p>
    </div>
    <div class="photo-caption"><span></span>{t('从一个具体业务问题开始')}</div>
  </section>
  <section class="section services-section" id="services">
    <div class="container">
      <SectionHeading
        eyebrow={t('01 / 产品与服务')}
        title={t('让AI服务企业降本增收')}
        description={t('通过培训、Agent部署与项目实施，提高效率，支持业务增长')}
      /><div class="service-grid">
        {
          services.map((service) => (
            <a class="service-card" href={service.href}>
              <>
                <div class="service-number">{service.number}</div>
                <div class="service-body">
                  <>
                    <Icon name={service.icon} size={34} />
                    <h3>{service.title}</h3>
                    <p>
                      {service.text}
                      <br />
                      {service.note}
                    </p>
                    <span class="text-link">
                      {service.link}
                      <Icon size={18} />
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section scenarios-section" id="scenarios">
    <div class="container">
      <SectionHeading
        eyebrow={t('02 / 应用场景')}
        title={t('从高频任务开始，让AI发挥作用')}
        description={t('以下为应用场景示例，具体方案根据企业条件设计')}
        href={p('/zh/scenarios/')}
        link={t('查看应用场景')}
      /><div class="scenario-grid">
        {
          scenarios.map((s) => (
            <a class="scenario-card" href={p(`/zh/scenarios/${s.slug}/`)}>
              <>
                <ScenarioImage index={s.image} alt={t('场景示意') + ': ' + s.title} />
                <div class="scenario-content">
                  <>
                    <h3>{s.title}</h3>
                    <p>{s.summary}</p>
                    <span class="text-link">
                      {t('场景示例')}
                      <Icon size={18} />
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section process-section" id="process">
    <div class="container">
      <SectionHeading
        eyebrow={t('03 / 项目实施')}
        title={t('从业务诊断，到持续运行')}
        href={p('/zh/implementation/')}
        link={t('了解实施方法')}
      /><ol class="process-grid">
        {
          steps.map((step, i) => (
            <li>
              <span class="process-number">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <>
                  <h3>{step.title}</h3>
                  <p>{step.subtitle}</p>
                </>
              </div>
              {i < 3 && (
                <span class="process-arrow" aria-hidden="true">
                  →
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section class="faq-section">
    <div class="container faq-layout">
      <div>
        <p class="eyebrow">{t('合作之前')}</p><h2>{t('您可能想了解')}</h2><a class="text-link" href={p('/zh/contact/')}
          >{t('交流具体需求')}<Icon size={18} /></a
        >
      </div><div class="faq-list">
        {
          faqs.slice(0, 3).map((faq) => (
            <details>
              <>
                <summary>
                  {faq.q}
                  <span aria-hidden="true">+</span>
                </summary>
                <p>{faq.a}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <ContactSection />
</SiteLayout>
