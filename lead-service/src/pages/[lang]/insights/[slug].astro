---
import { context } from '~/i18n';
const { t, p } = context(Astro.url.pathname);
import Layout from '../../../layouts/SiteLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContactSection from '../../../components/ContactSection.astro';
import { getData } from '~/data/site';
import { locales } from '~/i18n';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    getData(lang).articles.map((article) => ({ params: { lang, slug: article.slug }, props: { article } }))
  );
}
const { article } = Astro.props;
---

<Layout title={article.title} description={article.summary}
  ><PageHero
    eyebrow={`${t('资讯与观点')} / ${article.category}`}
    title={article.title}
    description={article.summary}
  /><section class="section">
    <article class="container prose reading">
      {
        article.paragraphs.map(([heading, text]) => (
          <section>
            <>
              <h2>{heading}</h2>
              <p>{text}</p>
            </>
          </section>
        ))
      }<p><a class="text-link" href={p('/zh/insights/')}>{t('← 返回资讯与观点')}</a></p>
    </article>
  </section><ContactSection /></Layout
>
